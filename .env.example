# .env Template
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# Model Configurations
LLM_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Chat Agent (no retrieval)
CHAT_MAX_TOKENS=1024
CHAT_TEMPERATURE=0.4

# ServiceNOW Agent (v1)
SNOW_AGENT_ID=your_agent_id
SNOW_AGENT_ALIAS_ID=your_alias_id
RDS_INSTANCE_ARN=your_rds_instance_arn
RDS_TABLE_NAME=snow_embeddings_table
# Tables selectable in the UI for the SNOW agent (comma-separated)
SNOW_TABLE_OPTIONS=snow_embeddings_table,XYZ123

# RCA Agent (v2) - uses the same pgvector store unless overridden
RCA_TABLE_NAME=
RCA_TOP_K=8
RCA_MAX_TOKENS=1500

# Solution Recommender Agent (v2) - leave blank to disable
SOLUTION_AGENT_ID=
SOLUTION_AGENT_ALIAS_ID=

# Intent router model (used only when multiple agents are configured)
AGENT_ROUTER_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
ROUTER_MAX_TOKENS=10
ROUTER_TEMPERATURE=0

# RDS connection (IAM authentication - no password)
DB_HOST=your_rds_endpoint.aws.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=iam_user_name
DB_SSLMODE=require
DB_CONNECT_TIMEOUT=10
RAG_TOP_K=5

# Hybrid search (vector + PostgreSQL full-text search, fused with RRF)
HYBRID_SEARCH_ENABLED=true
HYBRID_CANDIDATE_K=20
RRF_K=60

# Cross-encoder reranking (Bedrock Rerank API)
# Leave RERANK_MODEL_ARN blank to disable; falls back to fused order.
RERANK_ENABLED=true
RERANK_MODEL_ARN=arn:aws:bedrock:us-east-1::foundation-model/cohere.rerank-v3-5:0

# Application Settings
APP_PORT=8080
APP_HOST=0.0.0.0
